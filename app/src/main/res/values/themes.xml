<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FloraFilm" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/colorPrimaryLight</item>
        <item name="IconsTintThemeInverse">@color/iconsTintLight</item>
        <item name="TextViewColorThemeInverse">@color/black</item>
        <item name="SwitchTintTrack">@color/colorPrimaryLight</item>
        <item name="ColorPrimaryDayNight">@color/colorPrimaryLight</item>


        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
