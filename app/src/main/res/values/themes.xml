<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FloraFilm" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/colorPrimaryLight</item>
        <!-- Цвет текста на компонентах, использующих colorPrimary (например, MaterialButton) -->
        <item name="colorOnPrimary">@color/button_resume_view_tint</item>
        <!-- Цвет текста для компонентов на основной поверхности (например, текст у SwitchMaterial) -->
        <item name="colorOnSurface">@color/switchersSettings</item>

        <item name="IconsTintThemeInverse">@color/iconsTintLight</item>
        <item name="TextViewColorThemeInverse">@color/black</item>
        <item name="SwitchTintTrack">@color/colorPrimaryLight</item>
        <item name="ColorPrimaryDayNight">@color/colorPrimaryLight</item>


        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:statusBarColor">?attr/ColorPrimaryDayNight</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

    </style>

    <style name="Theme.FloraFilm" parent="Base.Theme.FloraFilm" />

    <style name="Theme.FloraFilm.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>