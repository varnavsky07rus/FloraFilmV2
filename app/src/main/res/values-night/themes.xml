<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FloraFilm" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/colorPrimaryDark</item>
        <!-- Цвет текста на компонентах, использующих colorPrimary (например, MaterialButton) -->
        <item name="colorOnPrimary">@color/button_resume_view_tint</item>
        <!-- Цвет текста для компонентов на основной поверхности (например, текст у SwitchMaterial) -->
        <item name="colorOnSurface">@color/switchersSettings</item>
        <item name="IconsTintThemeInverse">@color/iconsTintDark</item>
        <item name="TextViewColorThemeInverse">@color/white</item>
        <item name="SwitchTintTrack">@color/colorPrimaryDark</item>
        <item name="ColorPrimaryDayNight">@color/colorPrimaryDark</item>


        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.FloraFilm.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />


</resources>